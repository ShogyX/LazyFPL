# Copy to .env and fill in. .env is gitignored. Secrets are never logged.

# --- Core ---
FPL_ENV=dev
FPL_DATABASE_URL=postgresql+psycopg2://fpl:fpl@localhost:5432/fpl
FPL_LOG_LEVEL=INFO
FPL_LOG_JSON=true

# --- Operator FPL auth (for /me, /my-team selling prices) ---
FPL_FPL_ENTRY_ID=
FPL_FPL_SESSION_COOKIE=

# --- Odds-API keys (free tiers) ---
# Register for each provider's free tier, then paste the key here. The matching
# ingestor activates automatically (see `fpl odds status`). Until a key is set,
# that provider is a disabled no-op (no fetch, no budget spend).
FPL_SHARPAPI_KEY=          # SharpAPI free 12 req/min — Pinnacle no-vig (sharp anchor)
FPL_SGO_KEY=               # Sports Game Odds free — player props (goalscorer/SOT)
FPL_ODDSPAPI_KEY=          # OddsPapi free 250/mo — consensus + CLV
FPL_ODDSAPI_IO_KEY=        # odds-api.io free 100/hr — high-volume fallback (h2h)
FPL_API_FOOTBALL_KEY=      # API-Football free 100/day — soft odds + lineups/injuries

# --- Betfair Exchange (Delayed App Key) ---
# App key enables the provider, but live calls also need a session token from an
# interactive login (X-Authentication) — add a login flow before going live.
FPL_BETFAIR_APP_KEY=
FPL_BETFAIR_USERNAME=
FPL_BETFAIR_PASSWORD=

# --- Notifications ---
FPL_PUSHOVER_TOKEN=
FPL_PUSHOVER_USER=
FPL_SMTP_HOST=
FPL_SMTP_PORT=587
FPL_SMTP_USERNAME=
FPL_SMTP_PASSWORD=
FPL_SMTP_FROM=
FPL_SMTP_TO=
